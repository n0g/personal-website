<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pub.title }} — {{ site.name }}</title>
  <meta name="description" content="{{ pub.title }} — {{ pub.authors | join(', ') }} — {{ pub.badge }}">
  <meta name="citation_title" content="{{ pub.title }}">
{% for author in pub.authors %}
  <meta name="citation_author" content="{{ author | author_sort }}">
{% endfor %}
  <meta name="citation_publication_date" content="{{ pub | citation_date }}">
{% if pub.citation_type == "conference" %}
  <meta name="citation_conference_title" content="{{ pub.venue_full or '' }}">
{% elif pub.citation_type == "journal" %}
  <meta name="citation_journal_title" content="{{ pub.venue_full or '' }}">
{% if pub.extra and pub.extra.volume %}
  <meta name="citation_volume" content="{{ pub.extra.volume }}">
{% endif %}
{% if pub.extra and pub.extra.issue %}
  <meta name="citation_issue" content="{{ pub.extra.issue }}">
{% endif %}
{% elif pub.citation_type == "book" %}
{% if pub.extra and pub.extra.publisher %}
  <meta name="citation_publisher" content="{{ pub.extra.publisher }}">
{% endif %}
{% elif pub.citation_type in ("dissertation", "thesis") %}
  <meta name="citation_dissertation_institution" content="{{ (pub.extra and pub.extra.institution) or '' }}">
{% endif %}
{% if pub.extra and pub.extra.doi %}
  <meta name="citation_doi" content="{{ pub.extra.doi }}">
{% endif %}
{% if pub | pdf_url(site_url) %}
  <meta name="citation_pdf_url" content="{{ pub | pdf_url(site_url) }}">
{% endif %}
  <meta name="citation_abstract_html_url" content="{{ site_url }}/publications/{{ pub.slug }}.html">
{% set asset_prefix = "../" %}
{% include "_head_common.html.j2" %}
</head>
<body class="pub-page">

<header>
  <a href="../index.html">← {{ site.name }}</a>
</header>

<main>
  <div class="venue-row">
    <span class="badge {{ pub.badge_class }}">{{ pub.badge }}</span>
{% for a in (pub.award or []) %}
    <span class="award-badge">{{ a }}</span>
{% endfor %}
  </div>

  <h1>{{ pub.title }}</h1>
{% if pub.subtitle %}
  <p class="subtitle">{{ pub.subtitle }}</p>
{% endif %}
  <p class="authors">{% for author in pub.authors %}{% if author == "Matthias Fassl" %}<span class="me">{{ author }}</span>{% else %}{{ author }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</p>

  <div class="pub-links">
{% if pub.pdf %}
        <a class="pub-link pub-link-icon" href="{{ pub.pdf }}" target="_blank" rel="noopener noreferrer" download aria-label="Download PDF" title="Download PDF"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 1.5v8.25m0 0L4.75 6.5M8 9.75 11.25 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M2.5 11.5v1.75a1.25 1.25 0 0 0 1.25 1.25h8.5a1.25 1.25 0 0 0 1.25-1.25V11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
{% elif pub.pdf_external %}
        <a class="pub-link pub-link-icon" href="{{ pub.pdf_external }}" target="_blank" rel="noopener noreferrer" aria-label="Download PDF" title="Download PDF"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 1.5v8.25m0 0L4.75 6.5M8 9.75 11.25 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M2.5 11.5v1.75a1.25 1.25 0 0 0 1.25 1.25h8.5a1.25 1.25 0 0 0 1.25-1.25V11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
{% endif %}
{% for link in (pub.links or []) %}
        <a class="pub-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
{% endfor %}
  </div>
{% if pub.abstract %}

  <section class="block">
    <h2>Abstract</h2>
    <p class="abstract">{{ pub.abstract }}</p>
  </section>
{% endif %}
{% if pub.talks %}

  <section class="block">
    <h2>{% if pub.talks | length > 1 %}Talks{% else %}Talk{% endif %}</h2>
{% for talk in pub.talks %}
{% if talk.label %}
    <p class="video-caption">{{ talk.label }}</p>
{% endif %}
    <div class="video-wrap">
      <iframe src="{{ talk.embed_url }}" title="Talk: {{ pub.title }}{% if talk.label %} — {{ talk.label }}{% endif %}"
        frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        allowfullscreen loading="lazy"></iframe>
    </div>
{% endfor %}
  </section>
{% endif %}
{% if pub.bibtex %}

  <section class="block">
    <h2>BibTeX</h2>
    <div class="bibtex-wrap">
      <button class="copy-btn" type="button" data-copy-target="bibtex-src">Copy</button>
      <pre class="bibtex" id="bibtex-src">{{ pub.bibtex }}</pre>
    </div>
  </section>
{% endif %}
</main>

{% if pub.bibtex %}
<script src="../copy.js"></script>
{% endif %}

</body>
</html>
